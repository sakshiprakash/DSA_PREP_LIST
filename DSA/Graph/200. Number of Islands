Number of Islands (Time Comp = O(m × n) Space Comp = O(m × n))

class Solution {
    private void dfs(int row,int col, char[][] grid){

        int m=grid.length;
        int n=grid[0].length;

        if(row<0 || col<0 || row>=m || col>=n || grid[row][col]=='0'){
            return;
        }

        grid[row][col]='0';

        dfs(row-1,col,grid);//up
        dfs(row+1,col,grid);//down
        dfs(row,col-1,grid);//left
        dfs(row,col+1,grid);//right

    }


    public int numIslands(char[][] grid) {

        int m=grid.length;
        int n=grid[0].length;

        int count=0;

        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(grid[i][j]=='1'){
                    count++;
                    dfs(i,j,grid);
                }
            }
        }
        return count;
    }
}
